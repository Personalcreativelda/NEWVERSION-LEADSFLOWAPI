SERVICE_URL_API=https://api.leadsflowapi.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_SETUP=false
APP_URL=https://app.leadsflowapi.com
CORS_ORIGINS=https://app.leadsflowapi.com
DEMO_EMAIL=
DEMO_PASSWORD=
EVOLUTION_API_KEY=
EVOLUTION_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=                         # segredo aleatório com pelo menos 32 caracteres
PG_DATABASE=leadsflow
PG_HOST=localhost
PG_PASSWORD=
PG_PORT=5432
PG_SSL=false
PG_USER=postgres
PORT=4000
REQUIRE_EMAIL_CONFIRMATION=true
SMTP_FROM=LeadsFlow API <noreply@leadsflowapi.com>
SMTP_HOST=smtp.resend.com
SMTP_PASS=                         # chave da Resend (nunca a chave real neste ficheiro)
SMTP_PORT=465
SMTP_USER=resend
VITE_API_URL=https://api.leadsflowapi.com

# MinIO S3 Configuration
MINIO_ENDPOINT=                    # Ex: minio.personalcreativelda.com (sem porta)
MINIO_PORT=9000
MINIO_USE_SSL=true                 # Use true para HTTPS, false para HTTP
MINIO_ACCESS_KEY=                  # Access Key (ou use SERVICE_USER_MINIO)
MINIO_SECRET_KEY=                  # Secret Key (ou use SERVICE_PASSWORD_MINIO)
MINIO_BUCKET=leadflow-avatars      # Nome do bucket (será criado automaticamente)
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=                  # URL pública para acesso aos arquivos
                                   # Ex: https://minio.personalcreativelda.com
                                   # IMPORTANTE: Use o domínio do MinIO, não o console

# Variáveis alternativas do MinIO (Coolify/Docker)
SERVICE_USER_MINIO=                # Alternativa para MINIO_ACCESS_KEY
SERVICE_PASSWORD_MINIO=            # Alternativa para MINIO_SECRET_KEY


# Instagram/Facebook Webhook Configuration
# Token de verificação para webhooks do Meta (Instagram, Facebook, WhatsApp)
INSTAGRAM_VERIFY_TOKEN=             # Token de verificação do webhook Instagram
META_VERIFY_TOKEN=                  # Token de verificação genérico para Meta webhooks
# Cifra dos tokens e palavras-passe dos canais (AES-256-GCM). Texto aleatório longo, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não mudar depois de definida: os tokens já cifrados deixam de poder ser lidos.
CHANNEL_SECRETS_KEY=

# Ligar Facebook Messenger e Instagram pelo login da Meta (app Meta da LeadsFlow).
# Sem estas variáveis o app usa o formulário manual (token colado à mão).
META_APP_ID=
META_APP_SECRET=                   # também valida a assinatura dos webhooks (X-Hub-Signature-256)
META_INSTAGRAM_APP_ID=             # "ID do app do Instagram" (caso de uso API do Instagram): ativa o login próprio do Instagram
META_INSTAGRAM_APP_SECRET=         # "Chave secreta do app do Instagram" (caso de uso API do Instagram): assina os webhooks do Instagram
META_LOGIN_CONFIG_ID=              # opcional: Facebook Login for Business (config_id) em vez de "scope"
META_OAUTH_SCOPES=                 # opcional: substitui as permissões pedidas (ex.: pages_show_list,pages_messaging,pages_manage_metadata,business_management)
META_WA_CONFIG_ID=                 # WhatsApp oficial: config_id do Embedded Signup (exige Tech Provider)
API_PUBLIC_URL=https://api.leadsflowapi.com   # base do redirect: <API_PUBLIC_URL>/api/oauth/meta/callback

# Firebase Cloud Messaging — credencial APENAS na API/Coolify, nunca no dashboard ou APK.
# Recomendado: JSON completo da conta de serviço codificado em base64 numa só linha.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa ao JSON acima (a chave aceita \n no lugar de quebras de linha):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
