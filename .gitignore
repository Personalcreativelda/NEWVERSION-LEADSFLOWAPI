# Só o código vai para o GitHub: dependências, builds, ambientes e ficheiros
# locais ficam apenas na máquina.

# Variáveis de ambiente locais (NÃO commitar!)
# (.env.example e .env.android são modelos/config públicos e continuam versionados)
.env
.env.local
.env.*.local

# Dados do PostgreSQL
api/postgres-data/

# Dependências (instalar com npm install / npm ci)
node_modules/
api/node_modules/
.pnpm-store/
.npm/

# Build outputs
dist/
build/
api/dist/
api/build/
*.tsbuildinfo
coverage/

# Android (Capacitor) — o resto está em android/.gitignore
*.apk
*.aab
android/local.properties
android/.gradle/
android/app/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code — estado local (settings.json do projeto continua versionado)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Temporary files e backups
tmp/
temp/
*.tmp
*.bak

# Atualizações ao vivo do app (npm run release:mobile)
dist-mobile/
dist-mobile-*.zip
